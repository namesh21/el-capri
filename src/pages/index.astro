---
import { Image } from 'astro:assets';
import retratoBotox from '../assets/retrato-botox.jpg';
import retratoConsultorio from '../assets/retrato-consultorio.jpg';
import { site, waLink, tratamientos, sueros, pasos, faqs } from '../data/site';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/cormorant-garamond/500-italic.css';
import '@fontsource/jost/400.css';
import '@fontsource/jost/500.css';
import '@fontsource/jost/600.css';
import '../styles/global.css';

const title = `Botox y armonización facial en ${site.ciudad} | ${site.marca}`;
const description = `Botox, rellenos con ácido hialurónico, plasma facial y sueroterapia en ${site.ciudad}. Valoración médica personalizada y resultados naturales. Agenda por WhatsApp.`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'MedicalClinic',
      name: site.marca,
      url: site.url,
      telephone: `+${site.whatsapp}`,
      medicalSpecialty: 'Dermatologic',
      address: { '@type': 'PostalAddress', addressLocality: 'Medellín', addressRegion: 'Antioquia', addressCountry: 'CO' },
      areaServed: { '@type': 'City', name: 'Medellín' },
      availableService: tratamientos.map((t) => ({ '@type': 'MedicalProcedure', name: `${t.apodo} (${t.nombre})` })),
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
  ],
};
---
<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={site.url} />
    <meta name="robots" content="noindex" /> <!-- beta: remover ao publicar -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_CO" />
    <meta name="theme-color" content="#7a1023" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <header class="topbar">
      <div class="wrap topbar__in">
        <a href="#" class="brand" aria-label={site.marca}>
          <svg class="brand__mark" viewBox="0 0 32 44" aria-hidden="true">
            <path d="M16 2C16 2 3 18 3 28a13 13 0 0 0 26 0C29 18 16 2 16 2Z" fill="none" stroke="currentColor" stroke-width="1.6" />
            <path d="M16 20v17M11 28h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          </svg>
          <span class="brand__txt">Bienestar<small>desde adentro</small></span>
        </a>
        <nav class="nav" aria-label="Principal">
          <a href="#tratamientos">Tratamientos</a>
          <a href="#sobre-mi">Sobre mí</a>
          <a href="#proceso">Proceso</a>
          <a href="#preguntas">Preguntas</a>
        </nav>
        <a class="btn btn--sm" href={waLink()} target="_blank" rel="noopener">Agendar</a>
      </div>
    </header>

    <main>
      <!-- HERO -->
      <section class="hero">
        <div class="wrap hero__grid">
          <div class="hero__copy">
            <p class="eyebrow">Medicina estética · {site.ciudad}</p>
            <h1>Botox y armonización facial <em>con resultados que se ven naturales</em></h1>
            <p class="lead">
              Te cuido por fuera, pero sobre todo por dentro. Cada tratamiento empieza con una valoración médica y un plan
              hecho para tu rostro, no uno de catálogo.
            </p>
            <div class="hero__cta">
              <a class="btn" href={waLink('Hola, quiero agendar una valoración')} target="_blank" rel="noopener">
                Agenda tu valoración
              </a>
              <a class="link" href="#tratamientos">Ver tratamientos →</a>
            </div>
            <ul class="trust">
              <li>Valoración personalizada</li>
              <li>Producto sellado y trazable</li>
              <li>Control posterior incluido</li>
            </ul>
          </div>
          <figure class="hero__img">
            <Image src={retratoBotox} alt={`${site.profesional}, médica estética en ${site.ciudad}`} widths={[400, 600, 800]} sizes="(max-width: 860px) 90vw, 440px" loading="eager" />
            <figcaption>
              <strong>{site.profesional}</strong>
              <span>{site.titulo}</span>
            </figcaption>
          </figure>
        </div>
      </section>

      <!-- TRATAMIENTOS -->
      <section id="tratamientos" class="section">
        <div class="wrap">
          <header class="sec-head">
            <p class="eyebrow">Tratamientos</p>
            <h2>Lo que hacemos, <em>y para quién es</em></h2>
          </header>
          <ol class="tx">
            {tratamientos.map((t, i) => (
              <li class="tx__item" id={t.id}>
                <span class="tx__num">{String(i + 1).padStart(2, '0')}</span>
                <div class="tx__main">
                  <h3>{t.apodo}<span>{t.nombre}</span></h3>
                  <p>{t.resumen}</p>
                </div>
                <dl class="tx__meta">
                  <dt>Ideal para</dt>
                  <dd>{t.ideal}</dd>
                  <dt>Qué esperar</dt>
                  <dd>{t.detalle}</dd>
                </dl>
                <a class="tx__cta" href={waLink(t.msg)} target="_blank" rel="noopener" aria-label={`Consultar sobre ${t.apodo}`}>
                  Consultar
                </a>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- SUEROTERAPIA -->
      <section class="section section--blush">
        <div class="wrap sueros">
          <div>
            <p class="eyebrow">Sueroterapia</p>
            <h2>Nutrición que entra <em>directo a donde se necesita</em></h2>
            <p class="lead">
              Fórmulas intravenosas preparadas según tu valoración. Cómodas, en consultorio y con acompañamiento médico
              durante toda la sesión.
            </p>
            <a class="btn btn--ghost" href={waLink('Hola, quiero información sobre sueroterapia')} target="_blank" rel="noopener">
              Preguntar por un suero
            </a>
          </div>
          <ul class="sueros__list">
            {sueros.map((s) => (
              <li style={`--c:${s.color}`}>
                <span class="drop" aria-hidden="true"></span>
                <div>
                  <h3>{s.nombre}</h3>
                  <p>{s.texto}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- SOBRE MI -->
      <section id="sobre-mi" class="section">
        <div class="wrap about">
          <figure class="about__img">
            <Image src={retratoConsultorio} alt={`${site.profesional} en su consultorio`} widths={[320, 480]} sizes="(max-width: 860px) 70vw, 360px" />
          </figure>
          <div class="about__copy">
            <p class="eyebrow">Sobre mí</p>
            <h2>Tu bienestar <em>es mi misión</em></h2>
            <p>
              Soy {site.profesional}, {site.titulo.toLowerCase()} en {site.ciudad}. Creo en una estética que respeta tus rasgos:
              pequeños cambios, bien indicados, que te hacen ver descansada y segura de ti misma.
            </p>
            <p>
              Antes de cualquier procedimiento conversamos sobre lo que quieres lograr, revisamos tu historia y te explico
              con honestidad qué se puede esperar — y qué no.
            </p>
            <p class="about__reg">{site.registro}</p>
          </div>
        </div>
      </section>

      <!-- PROCESO -->
      <section id="proceso" class="section section--dark">
        <div class="wrap">
          <header class="sec-head">
            <p class="eyebrow">Cómo funciona</p>
            <h2>De tu primer mensaje <em>al resultado</em></h2>
          </header>
          <ol class="steps">
            {pasos.map((p, i) => (
              <li>
                <span>{i + 1}</span>
                <h3>{p.t}</h3>
                <p>{p.d}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- FAQ -->
      <section id="preguntas" class="section">
        <div class="wrap faq">
          <header class="sec-head">
            <p class="eyebrow">Preguntas frecuentes</p>
            <h2>Lo que más <em>nos preguntan</em></h2>
          </header>
          <div class="faq__list">
            {faqs.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <!-- CTA -->
      <section class="cta">
        <div class="wrap cta__in">
          <h2>¿Lista para verte <em>como te sientes?</em></h2>
          <p>Escríbenos y agenda tu valoración en {site.ciudad}.</p>
          <a class="btn btn--light" href={waLink()} target="_blank" rel="noopener">WhatsApp · {site.whatsappVisible}</a>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="wrap footer__in">
        <div>
          <strong>{site.marca}</strong>
          <p>{site.profesional} · {site.registro}<br />{site.direccion}</p>
        </div>
        <p class="footer__legal">
          Los procedimientos requieren valoración médica previa. Los resultados varían de una persona a otra.
        </p>
      </div>
    </footer>

    <a class="wa-float" href={waLink()} target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.4.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg>
    </a>
  </body>
</html>
